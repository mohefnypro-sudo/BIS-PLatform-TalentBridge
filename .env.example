# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://talentbridge:talentbridge@localhost:5432/talentbridge

# ─── Auth (NextAuth v5) ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=TalentBridge
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_MB=10

# ─── Queue / workers (optional; falls back to inline) ────────
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379

# ─── Email (driver: smtp | resend | none) ────────────────────
EMAIL_DRIVER=none
EMAIL_FROM="TalentBridge <no-reply@talentbridge.io>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

RESEND_API_KEY=

# ─── Storage (driver: local | s3) ────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# ─── Seed (optional defaults) ────────────────────────────────
SEED_ADMIN_EMAIL=admin@talentbridge.io
SEED_ADMIN_PASSWORD=Admin@1234
